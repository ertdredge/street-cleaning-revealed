#!/usr/bin/env ruby
# Generates the typical-temperature tables from the CSVs in docs/:
#   docs/typical-high-temperatures.csv -> src/street-cleaning-revealed/typical-highs.cpp (TYPICAL_HIGH_C)
#   docs/typical-low-temperatures.csv  -> src/street-cleaning-revealed/typical-lows.cpp  (TYPICAL_LOW_C)
# Run after editing either CSV:  bin/make-typical-highs
# Each table has one value per calendar day of a leap year (366), in order from January 1.
require 'csv'
require 'date'

ROOT = File.expand_path('..', __dir__)
DAYS = (Date.new(2024, 1, 1)..Date.new(2024, 12, 31)).map { |d| "#{d.month}/#{d.day}" }

def generate(csv_name, out_name, array, accessor, word)
  src = File.join(ROOT, 'docs', csv_name)
  out = File.join(ROOT, 'src', 'street-cleaning-revealed', out_name)
  by_day = {}
  CSV.read(src, headers: true).each do |r|
    key = r[0].strip
    abort "#{csv_name}: duplicate day #{key}" if by_day.key?(key)
    by_day[key] = Float(r[1])
  end
  missing = DAYS - by_day.keys
  extra = by_day.keys - DAYS
  abort "#{csv_name}: missing days: #{missing.inspect}" unless missing.empty?
  abort "#{csv_name}: unexpected days: #{extra.inspect}" unless extra.empty?

  lines = DAYS.each_slice(10).map { |slice| '  ' + slice.map { |d| format('%.1ff', by_day[d]) }.join(', ') + ',' }
  File.write(out, <<~CPP)
    // GENERATED by bin/make-typical-highs from docs/#{csv_name}. Do not edit by hand.
    // Typical (historical average) daily #{word} in deg C for each calendar day of a leap year,
    // January 1 first. Look values up with #{accessor}() in weather-display.h.
    #include "weather-display.h"

    const float #{array}[366] = {
    #{lines.join("\n")}
    };
  CPP
  puts "wrote #{out} (#{DAYS.size} days, #{by_day.values.min} to #{by_day.values.max} C)"
end

generate('typical-high-temperatures.csv', 'typical-highs.cpp', 'TYPICAL_HIGH_C', 'typicalHighC', 'high')
generate('typical-low-temperatures.csv',  'typical-lows.cpp',  'TYPICAL_LOW_C',  'typicalLowC',  'low')
