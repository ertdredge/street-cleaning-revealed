#!/usr/bin/env ruby
# Generates src/street-cleaning-revealed/typical-highs.cpp from docs/typical-high-temperatures.csv.
# Run after editing the CSV:  bin/make-typical-highs
# The table has one value per calendar day of a leap year (366), in order from January 1.
require 'csv'
require 'date'

ROOT = File.expand_path('..', __dir__)
SRC  = File.join(ROOT, 'docs', 'typical-high-temperatures.csv')
OUT  = File.join(ROOT, 'src', 'street-cleaning-revealed', 'typical-highs.cpp')

rows = CSV.read(SRC, headers: true)
by_day = {}
rows.each do |r|
  key = r[0].strip
  abort "duplicate day #{key}" if by_day.key?(key)
  by_day[key] = Float(r[1])
end
days = (Date.new(2024, 1, 1)..Date.new(2024, 12, 31)).map { |d| "#{d.month}/#{d.day}" }
missing = days - by_day.keys
extra = by_day.keys - days
abort "missing days: #{missing.inspect}" unless missing.empty?
abort "unexpected days: #{extra.inspect}" unless extra.empty?

lines = days.each_slice(10).map { |slice| '  ' + slice.map { |d| format('%.1ff', by_day[d]) }.join(', ') + ',' }
File.write(OUT, <<~CPP)
  // GENERATED by bin/make-typical-highs from docs/typical-high-temperatures.csv. Do not edit by hand.
  // Typical (historical average) daily high in deg C for each calendar day of a leap year,
  // January 1 first. Look values up with typicalHighC() in weather-display.h.
  #include "weather-display.h"

  const float TYPICAL_HIGH_C[366] = {
  #{lines.join("\n")}
  };
CPP
puts "wrote #{OUT} (#{days.size} days, #{by_day.values.min} to #{by_day.values.max} C)"
